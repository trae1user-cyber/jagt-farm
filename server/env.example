# Copy this file to server/.env and fill in your real values.
# NEVER commit the real .env file (it is gitignored).

MONGO_URI=mongodb+srv://USERNAME:PASSWORD@jagt.xfuqadb.mongodb.net/
MONGO_DB=jagt_farm

# Optional shared secret. When set, the website must send the same token
# (Settings -> Farm API token). Leave empty while testing.
MONGO_TOKEN=

PORT=8787
